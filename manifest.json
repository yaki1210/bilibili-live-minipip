{
  "manifest_version": 3,
  "name": "Bilibili Live 弹幕小窗 (M2)",
  "version": "0.2.2",
  "description": "接管直播页原生「小窗模式」按钮：真正的置顶小窗，镜像原播放器画面并显示实时弹幕。",
  "minimum_chrome_version": "116",
  "content_scripts": [
    {
      "matches": ["*://live.bilibili.com/*"],
      "js": ["src/main-guard.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://live.bilibili.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
